APP_ENV=development
LOG_LEVEL=INFO
DB_SSLMODE=disable
DOCS_ENABLED=true
METRICS_ENABLED=true

API_PUBLIC_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
COOKIE_SECURE=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=company_app
POSTGRES_DB=company_app
DB_USER=company_app_runtime
DB_PASSWORD=base-password-123
DB_MIGRATION_USER=company_app_migrator
DB_MIGRATION_PASSWORD=base-migration-password-123
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=base-postgres-password-123

REDIS_RATE_LIMIT_URL=redis://redis:6379/0
RATE_LIMIT_KEY_SECRET=rate-limit-key-12345678901234567890
CURSOR_SIGNING_KEY=cursor-signing-key-123456789012345678

ALLOW_DEMO_SEED=true
DEMO_PASSWORD=demo-password-123
