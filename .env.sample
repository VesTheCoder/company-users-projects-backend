APP_ENV=development
LOG_LEVEL=INFO
API_PUBLIC_ORIGIN=http://localhost:8080
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
FORWARDED_ALLOW_IPS=
COOKIE_SECURE=false
DB_HOST=postgres
DB_PORT=5432
DB_NAME=company_app
POSTGRES_DB=company_app
DB_USER=company_app_runtime
DB_PASSWORD=<runtime-secret>
DB_MIGRATION_USER=company_app_migrator
DB_MIGRATION_PASSWORD=<migration-secret>
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=<bootstrap-secret>
DB_SSLMODE=disable
REDIS_RATE_LIMIT_URL=redis://redis:6379/0
RATE_LIMIT_KEY_SECRET=<at-least-32-random-bytes>
CURSOR_SIGNING_KEY=<different-at-least-32-random-bytes>
ALLOW_DEMO_SEED=true
DOCS_ENABLED=true
METRICS_ENABLED=true
